# SQLite file (default agentgate.db)
AGENTGATE_DB=agentgate.db
# Public base URL used in the well-known document and by the buyer demo
AGENTGATE_BASE_URL=http://127.0.0.1:8000
# Dashboard token: open /dashboard/login?token=<this value>
MERCHANT_TOKEN=change-me

# Razorpay TEST keys (Dashboard -> Account & Settings -> API Keys, Test Mode). Live keys are refused.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: webhook secret for POST /webhooks/razorpay (polling works without it)
RAZORPAY_WEBHOOK_SECRET=

# LLM: any OpenAI-compatible chat-completions endpoint. Leave LLM_API_KEY blank to use the deterministic fakes.
# Gemini free tier (default):
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_S=60
# Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1        LLM_MODEL=openai/gpt-oss-120b
# NVIDIA: LLM_BASE_URL=https://integrate.api.nvidia.com/v1   LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# Ollama: LLM_BASE_URL=http://localhost:11434/v1             LLM_MODEL=llama3.2   LLM_API_KEY=ollama

# Fake payments outcomes for demos without Razorpay: comma list of paid|failed|pending|expired|error
FAKE_OUTCOMES=paid
